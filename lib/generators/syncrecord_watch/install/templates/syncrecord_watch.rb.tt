# Connects this app to Sync Record Watch. Sending is on when SYNCRECORD_WATCH_URL and
# SYNCRECORD_WATCH_API_KEY are set (never in the test environment).
SyncRecordWatch.configure do |config|
  config.url      = ENV["SYNCRECORD_WATCH_URL"]
  config.api_key  = ENV["SYNCRECORD_WATCH_API_KEY"]
  config.app_name = ENV.fetch("SYNCRECORD_WATCH_APP_NAME", "<%= Rails.application.class.module_parent_name.underscore.dasherize %>")

  # Lowest level sent: :debug, :info, :warn, :error, :fatal
  config.min_level = ENV.fetch("SYNCRECORD_WATCH_MIN_LEVEL", "info").to_sym

  # Attach the signed-in user's ID to log lines from web requests.
  # config.current_user_id = -> { Current.user&.id }
  # With Devise (gets the Rack env; run_callbacks: false avoids side effects):
  # config.current_user_id = ->(env) { env["warden"]&.user(scope: :user, run_callbacks: false)&.id }

  # Keys masked in structured fields. Default: the app's filter_parameters.
  # config.filter_keys = Rails.application.config.filter_parameters + [:iban]

  # Only add X-Request-ID to calls to these hosts (default: all hosts).
  # config.propagate_to = [/\.example\.com\z/]

  # Change or drop entries before they are sent (return nil to drop).
  # config.before_send = ->(entry) { entry["message"].include?("healthcheck") ? nil : entry }

  # Errors you never want reported (404s, bad requests, CSRF, RecordNotFound are already ignored).
  # config.ignore_errors += ["Twilio::REST::RestError"]

  # Monitoring, all on by default (see the README, "What is sent, and when"):
  # config.performance_monitoring = false  # endpoints, outside APIs, background jobs
  # config.job_queue_monitoring = false    # queue sizes from Solid Queue / Sidekiq
  # config.process_monitoring = false      # memory, garbage collection, Puma threads
  # config.database_monitoring = false     # slow queries, database health (PostgreSQL)
  # config.slow_query_ms = 500             # report queries at least this slow
  # config.report_dependencies = false     # gem list at boot (vulnerable gem alerts)

  # Browser tag (<%%= syncrecord_watch_tag %>): JavaScript errors and page speed. Needs SYNCRECORD_WATCH_BROWSER_KEY.
  # config.vitals_sample_rate = 0.25       # measure page speed on a quarter of page views
end
